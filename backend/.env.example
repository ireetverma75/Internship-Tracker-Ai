# Internship Tracker AI - Backend Environment Configuration

# Server
ENVIRONMENT=development
PORT=8000

# Database
# Default is SQLite for zero-config local development and university demos
DATABASE_URL=sqlite:///./internships.db
# For production PostgreSQL / Supabase, uncomment and fill:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Supabase Authentication & Storage (Optional for live cloud mode)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Providers (Optional; deterministic fallbacks run automatically if empty)
GEMINI_API_KEY=
OPENAI_API_KEY=

# File Upload Constraints
MAX_RESUME_SIZE_MB=10
